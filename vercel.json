{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node control-iot/build.mjs",
  "outputDirectory": "control-iot/dist",
  "redirects": [
    {
      "source": "/assets/downloads/Mando-IoT-2.0.apk",
      "destination": "/assets/downloads/Mando-IoT-2.3.apk",
      "permanent": false
    },
    {
      "source": "/assets/downloads/Mando-IoT-2.1.apk",
      "destination": "/assets/downloads/Mando-IoT-2.3.apk",
      "permanent": false
    },
    {
      "source": "/assets/downloads/Mando-IoT-2.2.apk",
      "destination": "/assets/downloads/Mando-IoT-2.3.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/downloads/:name.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
