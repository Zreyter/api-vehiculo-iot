MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=
MYSQL_DATABASE=vehiculo_iot
# Vacío para el laboratorio local; en RDS, ruta al certificado CA oficial de AWS.
MYSQL_SSL_CA=
# Generar el token de 8 caracteres con scripts/generar_token.py.
CONTROL_TOKEN=

# Credencial independiente del ESP8266 para la ruta unificada.
DEVICE_TOKEN=

# Origenes exactos del frontend.
BROWSER_ORIGINS=["http://localhost:4173"]

# Opcional: planificador de movimientos por voz. Solo en FastAPI.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4.1-mini
