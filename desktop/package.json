{
  "name": "vehiculo-iot-desktop",
  "version": "1.6.3",
  "description": "Panel de escritorio para Veh\u00edculo IoT, EC2 y ESP8266",
  "private": true,
  "author": "Zreyter",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:panel": "node scripts/prepare-panel.cjs",
    "start": "electron .",
    "test": "node scripts/prepare-panel.cjs && node --test tests/*.test.cjs",
    "dist": "node scripts/prepare-panel.cjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.zreyter.vehiculoiot",
    "productName": "Vehiculo IoT",
    "artifactName": "Vehiculo-IoT-${version}-Windows-x64.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
