{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node control-iot/build.mjs",
  "outputDirectory": "control-iot/dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
